# Copy to .env and adjust. docker-compose reads this file automatically.

ASPNETCORE_ENVIRONMENT=Production

# Database
DB_NAME=TaskManagement
DB_USER=postgres
DB_PASSWORD=postgres123

# JWT — Secret MUST be at least 32 characters. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret-at-least-32-chars
JWT_ISSUER=taskmanagement-api
JWT_AUDIENCE=taskmanagement-client
