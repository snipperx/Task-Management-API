meta {
  name: List Users
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/users?pageNumber=1&pageSize=50
  body: none
  auth: inherit
}

params:query {
  pageNumber: 1
  pageSize: 50
}

script:post-response {
  if (res.status === 200 && res.body.items.length > 0) {
    bru.setEnvVar("userId", res.body.items[0].id);
  }
}

docs {
  Needs `users:view` (Manager / Admin). Developers/Viewers get 403.
}
