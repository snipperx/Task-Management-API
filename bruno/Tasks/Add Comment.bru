meta {
  name: Add Comment
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/api/tasks/{{taskId}}/comments
  body: json
  auth: inherit
}

body:json {
  {
    "content": "Comment from the Bruno collection"
  }
}

assert {
  res.status: eq 201
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("commentId", res.body.id);
  }
}

docs {
  Needs `comments:create`. Stores the new id as `commentId` for the Comments folder.
}
