meta {
  name: Change Password
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/auth/change-password
  body: json
  auth: inherit
}

body:json {
  {
    "currentPassword": "{{adminPassword}}",
    "newPassword": "Admin@1234"
  }
}

docs {
  Requires a bearer token. Revokes the current refresh token — log in again afterwards.
}
