meta {
  name: Login
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

assert {
  res.status: eq 200
  res.body.accessToken: isString
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.accessToken);
    bru.setEnvVar("refreshToken", res.body.refreshToken);
    bru.setEnvVar("currentUserId", res.body.user.id);
  }
}

docs {
  Logs in as the seeded **admin**. Sets `accessToken` / `refreshToken` / `currentUserId`
  for the rest of the collection. Duplicate this request and swap the body for other roles,
  or use the "Login as ..." variants.
}
